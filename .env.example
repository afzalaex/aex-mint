# App identity
NUXT_PUBLIC_DOMAIN=mint.aex.design
NUXT_PUBLIC_TITLE=Aex Designs
NUXT_PUBLIC_DESCRIPTION=3rd year of daily art practice by Afzal, learn more: aex.design/every-days
NUXT_PUBLIC_CREATOR_ADDRESS=0x237047f8b97ab581974acaec36e6abba793a29b1
NUXT_PUBLIC_PLATFORM_URL=https://aex.design/every-days
NUXT_PUBLIC_DEFAULT_AVATAR=/icon.svg

# Data and RPC
# Indexer makes profile/collection/token loads fast; without it the app falls back to slow RPC scans.
NUXT_PUBLIC_INDEXER_ENDPOINTS=https://indexer.networked.art
# Put working public RPCs first. Avoid eth.llamarpc.com when it is down (HTTP 521).
NUXT_PUBLIC_RPC1=https://ethereum-rpc.publicnode.com
NUXT_PUBLIC_RPC2=https://eth.drpc.org
NUXT_PUBLIC_RPC3=https://1rpc.io/eth
NUXT_PUBLIC_MAINNET_RPC1=https://ethereum-rpc.publicnode.com
# Same gateway used by mint.networked.art
NUXT_PUBLIC_IPFS_GATEWAY=https://ipfs.vv.xyz/ipfs/

# Optional: create this in the WalletConnect dashboard
# https://dashboard.walletconnect.com/
NUXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Deployment — match mint.networked.art (SSR server on Vercel)
# Leave NITRO_PRESET unset on Vercel (auto-detect). Setting NUXT_SSR=false produces a blank SPA shell.
# NUXT_SSR=true
